{
    "name": "voxta-minecraft-companion",
    "version": "0.10.0",
    "description": "AI-powered Minecraft companion using Voxta and Mineflayer",
    "main": "./out/main/index.js",
    "scripts": {
        "dev": "electron-vite dev",
        "build": "electron-vite build",
        "preview": "electron-vite preview",
        "start": "electron-vite dev",
        "lint": "eslint src/",
        "lint:fix": "eslint src/ --fix",
        "typecheck": "tsc --noEmit",
        "format": "prettier --check src/",
        "format:fix": "prettier --write src/",
        "pack": "electron-vite build && electron-builder --dir",
        "dist": "electron-vite build && electron-builder",
        "test": "vitest run",
        "test:watch": "vitest",
        "postinstall": "patch-package"
    },
    "build": {
        "appId": "com.voxta.minecraft-companion",
        "productName": "Voxta Minecraft Companion",
        "icon": "resources/icon.png",
        "directories": {
            "output": "release"
        },
        "files": [
            "out/**/*"
        ],
        "extraResources": [
            {
                "from": "plugins/voxta-voice-bridge/build/libs/voxta-voice-bridge-1.0.1.jar",
                "to": "plugins/voxta-voice-bridge-1.0.1.jar"
            }
        ],
        "asarUnpack": [
            "node_modules/mineflayer/**",
            "node_modules/mineflayer-pathfinder/**"
        ],
        "win": {
            "target": [
                "nsis",
                "zip"
            ],
            "icon": "resources/icon.png"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "installerIcon": "resources/icon.ico",
            "uninstallerIcon": "resources/icon.ico",
            "installerHeaderIcon": "resources/icon.ico"
        }
    },
    "dependencies": {
        "@voxta/voxta-client": "^1.12.0",
        "bootstrap-icons": "^1.13.2",
        "extendable-media-recorder": "^9.2.40",
        "extendable-media-recorder-wav-encoder": "^7.0.140",
        "marked": "^18.1.1",
        "mineflayer": "^4.39.0",
        "mineflayer-pathfinder": "^2.4.5"
    },
    "overrides": {
        "whatwg-url": "^13.0.0"
    },
    "devDependencies": {
        "@electron-toolkit/preload": "^3.0.1",
        "@electron-toolkit/utils": "^4.0.0",
        "@eslint/js": "^10.0.1",
        "electron": "^43.8.0",
        "electron-builder": "^26.15.3",
        "electron-vite": "^5.0.0",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "patch-package": "^8.0.1",
        "prettier": "^3.9.10",
        "solid-js": "^1.9.17",
        "typescript": "^5.7.0",
        "typescript-eslint": "^8.71.2",
        "vite": "^7.3.7",
        "vite-plugin-solid": "^2.11.0",
        "vitest": "^4.1.4"
    }
}
